{
  "name": "aura-virtual-try-on",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:element": "tsc -b && vite build --config vite.element.config.ts",
    "build:all": "npm run build && npm run build:element",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/node": "22.13.4",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "playwright": "1.55.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
